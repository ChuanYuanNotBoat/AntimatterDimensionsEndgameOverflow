{
  "purpose": "ADE acceptance policy stays outside the generic i18n service. Unmatched findings remain shared/unclassified.",
  "domains": [
    {
      "id": "automator",
      "pattern": "automator|script-template"
    },
    {
      "id": "h2p",
      "pattern": "h2p|how-to-play|help-tab"
    },
    {
      "id": "news-quotes-ending",
      "pattern": "(?:/quotes/|secret-formula/news|ending|credits|changelog|news-ticker)"
    },
    {
      "id": "breakdown-statistics",
      "pattern": "multiplier.*(?:breakdown|tab)|statistics|last-ten|past-runs|multiplier-tab"
    },
    {
      "id": "pelle",
      "pattern": "pelle|doomed|doom|rift|galaxy-generator"
    },
    {
      "id": "glyphs",
      "pattern": "glyph|alchemy"
    },
    {
      "id": "automation",
      "pattern": "autobuyer|hotkeys"
    },
    {
      "id": "infinity",
      "pattern": "infinity|replicanti|break-infinity"
    },
    {
      "id": "eternity",
      "pattern": "eternity|time-stud|dilation"
    },
    {
      "id": "dimensions",
      "pattern": "dimension|tickspeed"
    },
    {
      "id": "reality",
      "pattern": "reality|perk"
    },
    {
      "id": "ade2-progression",
      "pattern": "compression|overcharge|universe|ethereal|endgame|ascension|collider|hadrons|divinity|galactic"
    },
    {
      "id": "celestials",
      "pattern": "celestial|slabdrill|teresa|effarig|enslaved|laitela|\\bra\\b|alpha"
    },
    {
      "id": "options-save",
      "pattern": "options|storage|migration|notation|theme|away-progress"
    }
  ],
  "acceptance": {
    "errors": [
      "missing-base-key",
      "catalog-error",
      "parameter-error",
      "localized-identity-dependency",
      "text-ref-error",
      "stale-locale-cache"
    ],
    "review": [
      "english-fallback",
      "mixed-language-output",
      "identical-translation",
      "string-dependency",
      "dynamic-translation-key",
      "hardcoded-ui-english",
      "duplicate-translation",
      "adec-available-fallback"
    ],
    "note": "Fallback/mixed-language candidates are review queues, not proof of a defect or a release-wide translation claim. Never translate user code, canonical identifiers, CSS keys or numeric notation."
  },
  "reviewedDependencies": [
    {
      "file": "src/i18n/vue-adapter.js",
      "reason": "translated-comparison",
      "disposition": "display-only",
      "explanation": "Compare original and translated text only to select a scoped display rule; result never enters an identity, save or gameplay branch.",
      "expressions": [
        "result !== value",
        "translated !== value"
      ]
    }
  ]
}
